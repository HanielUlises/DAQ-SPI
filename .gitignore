# ---------------------------------------------------------------------------
# Herramientas de la PC (compilación con MSVC)
# ---------------------------------------------------------------------------
# prueba_enlace.exe y sus DLL se conservan a propósito: permiten ejecutar la
# prueba en Windows sin Visual Studio.
herramientas/**/*.obj
herramientas/**/*.pdb

# ---------------------------------------------------------------------------
# Sistema / editores
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
.vscode/
.idea/
.cache/
compile_commands.json

# Ejecutable de las pruebas del protocolo
protocolo/prueba_protocolo
protocolo/prueba_protocolo.exe

# Ejecutable de prueba_enlace en Linux
herramientas/prueba_enlace/prueba_enlace

# Pruebas del enlace: se versionan los reportes (PDF), las notas y la salida
# de prueba_enlace; los registros CSV y los archivos intermedios se regeneran.
resultados/**/*.csv
resultados/*/*/
__pycache__/

# Binarios del visor y de sus pruebas
herramientas/visor_enlace/visor_enlace
herramientas/visor_enlace/prueba_bits
