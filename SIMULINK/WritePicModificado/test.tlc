    SFB_EXTERN_C void test_Start_wrapper(void);
    SFB_EXTERN_C void test_Outputs_wrapper(const %<uint64Type> *u0,
			%<uint64Type> *y0);
    SFB_EXTERN_C void test_Terminate_wrapper(void);
    void test_Outputs_wrapper_accel(const %<uint64Type> *u0,
			%<uint64Type> *y0){
    test_Outputs_wrapper(u0,
			y0);
    }
#undef SFB_EXTERN_C

    %closefile cFile

    %<LibAddToCommonIncludes("%<hFileName>.h")>

  %else
    %assign hFileName = "test_cgen_wrapper"
    %assign hFileNameMacro = FEVAL("upper", hFileName)
    %openfile hFile = "%<hFileName>.h"
    %selectfile hFile
