    %closefile cFile

    %<LibAddToCommonIncludes("%<hFileName>.h")>

  %openfile externs

    %assign u0DT = FixPt_GetInputDataType(0)
    %assign y0DT = FixPt_GetOutputDataType(0)
    #ifdef __cplusplus
    #define SFB_EXTERN_C extern "C"
    #else
    #define SFB_EXTERN_C extern
    #endif

    SFB_EXTERN_C void test_Start_wrapper(void);

    SFB_EXTERN_C void test_Outputs_wrapper(const %<uint64Type> *u0,
			%<uint64Type> *y0);

    SFB_EXTERN_C void test_Terminate_wrapper(void);

    #undef SFB_EXTERN_C
  %closefile externs
  %<LibCacheExtern(externs)>

